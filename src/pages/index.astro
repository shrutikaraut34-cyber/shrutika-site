---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Anagram from '../components/Anagram.astro';
import PostRows from '../components/PostRows.astro';
import { SITE, HAS_CV, HAS_PORTRAIT, getPosts, url } from '../lib/site';
import { VIDEOS } from '../lib/videos';

const posts = getPosts().slice(0, 4);
---
<Base desk>
  <Hero />

  <section id="about" class="about wrap" aria-labelledby="about-title">
    <div class="about-side">
      <h2 id="about-title" class="section-title">Nice to<br />meet you.</h2>
      <!-- Styled like the speaker badge on the desk above -->
      <aside class="profile paper" aria-label="At a glance">
        <span class="profile-top" aria-hidden="true"></span>
        <dl class="facts">
          <div><dt>Studied</dt><dd>BSW (Social Work + Psychology)</dd></div>
          <div><dt>Writes about</dt><dd>Society, psychology, art, films and culture</dd></div>
          <!-- Shrutika: change this to the kind of work you are looking for. -->
          <div><dt>Open to</dt><dd>Communications, advocacy and mental health work</dd></div>
        </dl>
      </aside>
    </div>
    <div class="about-body">
      {HAS_PORTRAIT && <img class="portrait" src={url('portrait.jpg')} alt="Portrait of Shrutika" width="480" height="600" />}
      <!-- Shrutika: rewrite this in your own words. -->
      <p class="lead">
        Hi, I’m Shrutika. I’ve always been curious, inquisitive, and drifting through multiple thoughts.
        I love learning new things and expanding my horizons. Never back away from a challenge, and
        always ready to lead or help.
      </p>
      <p>
        I have always been interested in expression, whether it’s through stories, theatre, narration,
        writing or music. I’m a lover of all things deepen the connection between people. My favorite
        things is sharing what i feel and pushing for dialogue about all things that make us sit and think.
      </p>
      {HAS_CV && <a class="button quiet" href={url('cv.pdf')} download>Download my CV (PDF)</a>}
    </div>
  </section>

  <section id="writing" class="writing wrap" aria-labelledby="writing-title">
    <div class="head">
      <h2 id="writing-title" class="section-title">Writing</h2>
      <a href={url('writing/')}>All writing</a>
    </div>
    <div class="sheet paper"><PostRows posts={posts} /></div>
  </section>

  <section id="videos" class="videos wrap" aria-labelledby="videos-title">
    <div class="head">
      <h2 id="videos-title" class="section-title">Video Content portfolio</h2>
    </div>
    <ul class="reels">
      {VIDEOS.map((v) => (
        <li>
          <a href={v.link} target="_blank" rel="noopener noreferrer">
            <span class="frame">
              <img src={url(`videos/${v.thumb}`)} alt="" loading="lazy" width="360" height="640" />
              <span class="platform">{v.platform}</span>
            </span>
            <span class="v-title">{v.title}</span>
            <span class="v-by">{v.by}<span class="visually-hidden"> on {v.platform}, opens in a new tab</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Anagram />

  <section id="contact" class="contact wrap" aria-labelledby="contact-title">
    <div class="say-wrap">
      <h2 id="contact-title" class="say">Say hello.</h2>
    </div>
    <p class="contact-note">For writing, speaking, or work, email is the best way to reach me.</p>
    <a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    {(SITE.linkedin || HAS_CV) && (
      <p class="elsewhere">
        {SITE.linkedin && <a href={SITE.linkedin}>LinkedIn</a>}
        {HAS_CV && <a href={url('cv.pdf')} download>CV (PDF)</a>}
      </p>
    )}
  </section>
</Base>

<style>
  section { scroll-margin-top: 4.5rem; }

  /* About */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    padding-block: var(--section);
  }
  .about .section-title { font-size: var(--step-4); }
  .about-body { max-width: var(--measure); }
  .about-body p { margin: 0 0 1.1em; }
  .lead { font-size: var(--step-1); line-height: 1.4; }
  .portrait { width: 100%; max-width: 20rem; height: auto; margin-bottom: 2rem; border-radius: 4px; }
  .profile { max-width: 24rem; margin-top: 2.5rem; overflow: hidden; }
  /* A plain blue band with a punched slot, like the speaker badge on the desk */
  .profile-top {
    position: relative;
    display: block;
    height: 2.4rem;
    background: #1e32b4;
  }
  .profile-top::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.6rem;
    height: 0.5rem;
    translate: -50% -50%;
    border-radius: 1rem;
    background: #e6e9f5;
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.25);
  }
  .facts { margin: 0; padding: 0.4rem 1.25rem; font-family: var(--sans); }
  .facts > div { padding-block: 0.8rem; }
  .facts > div + div { border-top: 1px solid var(--mist); }
  .facts dt { font-size: var(--step--1); color: var(--ink-soft); }
  .facts dd { margin: 0.15rem 0 0; font-weight: 600; line-height: 1.3; }

  /* Writing */
  .writing { padding-block: clamp(2rem, 6vw, 4rem); }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .head a { font-family: var(--sans); font-weight: 600; }
  .sheet { padding: 0.25rem clamp(1.25rem, 3vw, 2.5rem); }

  /* Video portfolio: tall thumbnails, like the reels they come from */
  .videos { padding-block: clamp(2rem, 6vw, 4rem); }
  .reels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 2rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reels a { display: block; text-decoration: none; }
  .frame {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 6px;
    background: var(--mist);
    box-shadow: 0 1px 2px rgb(14 20 70 / 0.12), 0 10px 24px -10px rgb(14 20 70 / 0.35);
  }
  .frame img { width: 100%; height: 100%; object-fit: cover; transition: scale 250ms ease; }
  .reels a:hover .frame img, .reels a:focus-visible .frame img { scale: 1.05; }
  .platform {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .v-title {
    display: block;
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: 1.05rem;
    font-weight: 650;
    font-stretch: 90%;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .reels a:hover .v-title, .reels a:focus-visible .v-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .v-by { display: block; margin-top: 0.25rem; font-family: var(--sans); font-size: var(--step--1); color: var(--ink-soft); }

  /* Contact */
  .contact {
    padding-block: var(--section) clamp(2.5rem, 8vw, 5rem);
  }
  .say {
    margin: 0;
    font-family: var(--sans);
    font-size: clamp(3.5rem, 13vw, 11rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.88;
    letter-spacing: -0.035em;
  }
  .say-wrap { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.5rem 1.5rem; }
  .contact-note { margin: 2rem 0 0.5rem; color: var(--ink-soft); }
  .email {
    font-family: var(--sans);
    font-size: clamp(1.4rem, 1rem + 2.2vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration-thickness: 2px;
    overflow-wrap: anywhere;
  }
  .elsewhere { display: flex; gap: 1.5rem; margin: 1.5rem 0 0; font-family: var(--sans); font-weight: 600; }

  @media (max-width: 48rem) {
    .about { grid-template-columns: 1fr; }
  }

  /* Phones: tighter rhythm */
  @media (max-width: 40rem) {
    .about { gap: 1.5rem; }
    .about .section-title { font-size: 2.6rem; }
    .lead { font-size: 1.25rem; }
    .about-side { display: contents; }
    .profile { order: 3; margin-top: 0.5rem; }
    .facts dd { font-size: 1rem; }
    .head { margin-bottom: 1.25rem; }
    .say { font-size: 22vw; }
    .contact-note { margin-top: 1.5rem; font-size: 1rem; }
    .email { font-size: 1.35rem; }
  }
</style>
